MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 3790}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Exec_01_Anna_01
      m_CommSubtitle: Ben, you should be in the Executive Suites. If there is any intel on what Zaphire is up to, it should be here.
    - m_EventType: 0
      m_TriggerDelay: 6.35
      m_CommAudioEvent: Play_Comm_Exec_01_Ben_02
      m_CommSubtitle: I'll take a look around.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Exec_02_Anna_01
      m_CommSubtitle: Ben, take the elevator ahead of you. It's your best bet to get down to the labs and get eyes on Riezol manufacturing.
    - m_EventType: 0
      m_TriggerDelay: 6.1
      m_CommAudioEvent: Play_Comm_Exec_02_Ben_02
      m_CommSubtitle: Hope it's as fancy as this floor.
