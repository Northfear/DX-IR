--- !u!114 &9507
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1099}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Exec_03_Anna_01
      m_CommSubtitle: Uhh...Ben.
    - m_EventType: 0
      m_TriggerDelay: 1.5
      m_CommAudioEvent: Play_Comm_Exec_03_Ben_02
      m_CommSubtitle: Yeah?
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Comm_Exec_03_Anna_03
      m_CommSubtitle: Remember when I said this was your best bet? I may have been wrong.
    - m_EventType: 0
      m_TriggerDelay: 7.5
      m_CommAudioEvent: Play_Comm_Exec_03_Ben_04
      m_CommSubtitle: What's going on?
    - m_EventType: 1
      m_TriggerDelay: 8.6
      m_CommAudioEvent: Play_Comm_Exec_03_Anna_05
      m_CommSubtitle: I'm hearing a lot of chatter over the comms, I think you may have some company waiting for you.
    - m_EventType: 0
      m_TriggerDelay: 13.3
      m_CommAudioEvent: Play_Comm_Exec_03_Ben_06
      m_CommSubtitle: That's nice of them to wait. I'll hurry up then.
