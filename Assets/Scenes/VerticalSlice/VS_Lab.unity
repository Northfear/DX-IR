--- !u!114 &21069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: AGGRESSIVE
      m_ChoiceHighlightString: Disturbances? Heh, I'm just getting started. You're running a criminal operation here and I'm going to get to the bottom of it.
      m_ConnectingConversation: {fileID: 21070}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_003
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_003
        m_SequenceDialog:
        - m_DialogText: Disturbances? Heh, I'm just getting started. You're running a criminal operation here and I'm going to get to the bottom of it.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_004
        m_BodyAnimationName: turntable
        m_AudioVO: Play_CON_SaTi_Tiven_004
        m_SequenceDialog:
        - m_DialogText: You're a confident man Mr. Saxon. That's a valuable trait, one that we test for. There's no need strong-arming me.
          m_Duration: 8
        - m_DialogText: I'll tell you whatever you want. You're no threat to me.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: SUSPICIOUS
      m_ChoiceHighlightString: You don't seem the least bit surprised to see me. What are you doing here?
      m_ConnectingConversation: {fileID: 21070}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_005
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_005
        m_SequenceDialog:
        - m_DialogText: You don't seem the least bit surprised to see me. What are you doing here?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_006
        m_BodyAnimationName: turntable
        m_AudioVO: Play_CON_SaTi_Tiven_006
        m_SequenceDialog:
        - m_DialogText: You will find very little surprises me Mr. Saxon. I am a scientist and I'm simply doing my work.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: LIE
      m_ChoiceHighlightString: No, I'm Belltower... special ops. And I need your help tracking down an... interloper.
      m_ConnectingConversation: {fileID: 21070}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_007
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_007
        m_SequenceDialog:
        - m_DialogText: No, I'm Belltower... special ops. And I need your help tracking down an... interloper.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_008
        m_BodyAnimationName: turntable
        m_AudioVO: Play_CON_SaTi_Tiven_008
        m_SequenceDialog:
        - m_DialogText: Very amusing Mr. Saxon. I know exactly who you are. So if you're done playing games lets get to the point of why you're here.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 11235}
    m_AnimationName: Default_CON_SaTi_Tiven_002
    m_BodyAnimationName: turntable
    m_AudioVO: Play_CON_SaTi_Tiven_002
    m_SequenceDialog:
    - m_DialogText: I would hazard to guess that you're the source of the disturbances in my laboratory tonight.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 11236}
--- !u!114 &21070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
