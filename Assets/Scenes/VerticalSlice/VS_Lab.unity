  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Establish Identity
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: 'IDENTITY '
      m_ChoiceHighlightString: How did you know my name?
      m_ConnectingConversation: {fileID: 21071}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_009
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_009
        m_SequenceDialog:
        - m_DialogText: How did you know my name?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_010
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_010
        m_SequenceDialog:
        - m_DialogText: I know a lot about you. Intimate details. I know what's inside your head. And I know you want it out.
          m_Duration: 10
        - m_DialogText: My name is Isaac Tiven, and I engineered the Argus Implant, which you must be familiar with by now.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: ISAAC
      m_ChoiceHighlightString: Very well Isaac. I know who you are. And I'll know if you're lying. So don't jerk me around!
      m_ConnectingConversation: {fileID: 21071}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_011
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_011
        m_SequenceDialog:
        - m_DialogText: Very well Isaac. I know who you are. And I'll know if you're lying. So don't jerk me around!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_012
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_012
        m_SequenceDialog:
        - m_DialogText: Splendid. Now that we've been acquainted we can proceed.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
