    m_ProfileText: 
  m_PreChoiceDialogSequence: []
  m_ConversationCamera: {fileID: 11236}
--- !u!114 &20978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: Topics of Question
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: ARGUS IMPLANT
      m_ChoiceHighlightString: The Argus Implant. You created it?
      m_ConnectingConversation: {fileID: 20978}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Saxon_013
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 4ccf1e378ae4ff148b722c5d4820c4b5, type: 3}
        m_SequenceDialog:
        - m_DialogText: The Argus Implant. You created it? What does it do?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_014
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 3e1920bc1c8cd964a896398f3c84552a, type: 3}
        m_SequenceDialog:
        - m_DialogText: A brilliant piece of work. Top of the line espionage. It monitors
            your location and transmits it at regular intervals.
          m_Duration: 7.30000019
        - m_DialogText: Not just that, but sights, sounds, smells. It's like having
            your own guardian angel, over your shoulder. Always watching.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Saxon_015
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 121ec0aea6c21e54080c43144fe44130, type: 3}
        m_SequenceDialog:
        - m_DialogText: How did I get it? I never consented to this. And during my
            time with Belltower it never appeared on any of my charts.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_016
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: b0ed7e7f026bf074b9672ba84202d060, type: 3}
        m_SequenceDialog:
        - m_DialogText: Well originally it was only for foreign agents. Prisoners
            of war and such. So when they were released back to their home
          m_Duration: 7.19999981
        - m_DialogText: countries and agencies we could keep an eye on them. But Belltower
            has become more and more... flexible.
          m_Duration: 8.60000038
        - m_DialogText: And this type of thing has become more common.
          m_Duration: 3.29999995
        - m_DialogText: Seriously Ben, did you think you could join the Tyrants without
            someone keeping a close watch.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_017
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: d9d1b167fcae7ad4f814bcfc4b3cebf5, type: 3}
        m_SequenceDialog:
        - m_DialogText: Namir! He's been watching me. He knows I'm here.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: TYRANTS
      m_ChoiceHighlightString: You're working for the Tyrants...
      m_ConnectingConversation: {fileID: 20978}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_018
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 77a2bb3c30abdbb43aee63f9c12a69b2, type: 3}
        m_SequenceDialog:
        - m_DialogText: You're working for the Tyrants. They're a group of murderers,
            which makes you an accessory to murder.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_019
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: fe6520ee75a56dc459e365558d80d612, type: 3}
        m_SequenceDialog:
        - m_DialogText: 'Please. I''m a scientist. I''m merely pushing the boundaries
            of what is possible. I''m not responsible '
          m_Duration: 6.19999981
        - m_DialogText: for what other people do with my creations. The Tyrants are
            just another a client. A powerful client, but a client nonetheless.
          m_Duration: 8.5
        - m_DialogText: ' And look at the good we''ve been able to achieve. Riezol
            is going to save millions of lives.'
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: RIEZOL
      m_ChoiceHighlightString: So you're responsible for the new 'miracle drug' Riezol?
      m_ConnectingConversation: {fileID: 20978}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Saxon_020
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 8dcc2bd13ca1feb4880f0f71280ec3c6, type: 3}
        m_SequenceDialog:
        - m_DialogText: So you're responsible for the new 'miracle drug' Riezol?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_021
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 60f68fac89b8f3a4095051796d7679a1, type: 3}
        m_SequenceDialog:
        - m_DialogText: I can't take all the credit for Riezol. I'm an engineer by
            training. But Zaphire Biotech employs the most talented chemists in
          m_Duration: 8
        - m_DialogText: the world. And we have benefactors with deep pockets. We're
            doing what no one has managed to do.
          m_Duration: 7
        - m_DialogText: We're challenging VersaLife, head on. After Riezol hits the
            market
          m_Duration: 5.19999981
        - m_DialogText: its going to be adopted by Limb clinics one after another.
            People won't even remember what Neuropozyne was.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_022
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 02a787a780189384897896d097c2cb42, type: 3}
        m_SequenceDialog:
        - m_DialogText: People say Riezol isn't safe. That it hasn't been tested properly.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_023
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: e6ae1ed8f2205c4439681e31fc86e1b3, type: 3}
        m_SequenceDialog:
        - m_DialogText: Riezol has been available on the black market for years already.
            Do you think that's an accident? Its part of our
          m_Duration: 3
        - m_DialogText: accelerated testing' regime. We've been able to iterate on
            the drug freely, without any oversight. And now we're prepared to
          m_Duration: 3
        - m_DialogText: reap the rewards. It's not our fault if some of the less scrupulous
            go-betweens involved have been cutting the drug.
          m_Duration: 3
        - m_DialogText: We've factored this into our field testing, and the results
            are nothing less than stellar.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString: ENOUGH
      m_ChoiceHighlightString: I've heard enough. I think I understand the situation.
      m_ConnectingConversation: {fileID: 20979}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_024
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 33881b4359769ae41b742f60849be3ec, type: 3}
        m_SequenceDialog:
        - m_DialogText: I've heard enough. I think I understand the situation.
          m_Duration: 4.30000019
        - m_DialogText: But what I don't understand is why you're helping me. Why
            are you giving me this information?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_025
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 16eab7fa6c156c944ac167767777573a, type: 3}
        m_SequenceDialog:
        - m_DialogText: You asked. I answered. I'm not hiding anything. The question
            is, what are you hiding? Why did you come here?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString: 
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText: 
    m_ProfileText: 
