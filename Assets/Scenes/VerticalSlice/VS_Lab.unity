--- !u!114 &20979
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: First Conclusion
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: TO KILL
      m_ChoiceHighlightString: I came here to end this. And if that means I have to
        take you out... so be it.
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_026
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: f3ab42ffa632729429b098ce90de0737, type: 3}
        m_SequenceDialog:
        - m_DialogText: I came here to end this. And if that means I have to take
            you out... so be it.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_027
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 6c471e336fe293945b1945a129bd903b, type: 3}
        m_SequenceDialog:
        - m_DialogText: 'How barbaric. I overestimated you Mr. Saxon. I hope you''ll
            reconsider. '
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21013}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: REMOVE IMPLANT
      m_ChoiceHighlightString: I want this bug out of my head! If you're the one who
        implanted it, then you can remove it!
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Saxon_028
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: bdc5bff80cb26244eba674921aeb2e9c, type: 3}
        m_SequenceDialog:
        - m_DialogText: I want this bug out of my head! If you're the one who implanted
            it, then you can remove it!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_029
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 144ff92f32ad2e64b841692d1c7b3a16, type: 3}
        m_SequenceDialog:
        - m_DialogText: Regrettably, I can't remove it now, Ben. There's not enough
            time, with the lab under emergency lock-down.
          m_Duration: 5.80000019
        - m_DialogText: A rushed procedure could render you brain dead. But I can
            do this... I'll administer a disruptive magnetic charge into your skull.
          m_Duration: 8.19999981
        - m_DialogText: That will delay the implant's transmission rate and scramble
            some of the data. Consider this a favor.
          m_Duration: 6.19999981
        - m_DialogText: It should give you some breathing room to accomplish... whatever
            it is you're pursuing.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21013}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: GET NAMIR
      m_ChoiceHighlightString: Namir screwed me over once. I'm not going to let him
        get away with it again. If what you said is true, then Namir must be nearby,
        on my trail.
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_030
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 7f003bebace37a647b1620df01975527, type: 3}
        m_SequenceDialog:
        - m_DialogText: Namir screwed me over once. I'm not going to let him get away
            with it again.
          m_Duration: 5.5999999
        - m_DialogText: If what you said is true, then Namir must be nearby, on my
            trail. Help me find him and I'll let you live.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_031
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 7b2fc16d773fb20419552bcf05beab0f, type: 3}
        m_SequenceDialog:
        - m_DialogText: How compassionate of you. You're right though. Namir is here,
            tonight. I'll give you a pass code which should let you bypass
          m_Duration: 8.10000038
        - m_DialogText: 'security measures in the lower lab. I hope you find what
            you''re looking for. '
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21013}
      m_TriggerFunctionName: LearnPassword
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString: 'APPEAL '
      m_ChoiceHighlightString: Listen Isaac. I can respect what you're doing here...
      m_ConnectingConversation: {fileID: 20980}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_032
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 722bd4d4a9078c3409d2fbe88ff85aec, type: 3}
        m_SequenceDialog:
        - m_DialogText: Listen Isaac. I can respect what you're doing here. Zaphire
            Biotech is shaking up the whole anti-rejection market.
          m_Duration: 8
        - m_DialogText: And that's probably a good thing. But Namir, and the Tyrants.
            They're pure poison.
          m_Duration: 7.0999999
        - m_DialogText: And your involvement with them is going to corrupt everything
            you touch.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_033
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: be175d0d21a696840a64a06597052eb3, type: 3}
        m_SequenceDialog:
        - m_DialogText: That's quite an indictment. How can you be so sure?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString: 
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText: 
    m_ProfileText: 
  m_PreChoiceDialogSequence: []
  m_ConversationCamera: {fileID: 11236}
--- !u!114 &20980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: Appeal Choices
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: HISTORY
      m_ChoiceHighlightString: Because it happened to me. I used to be one of them..
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_034
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 8242eab20cd0a8e4bb27e6d01aac57b9, type: 3}
        m_SequenceDialog:
        - m_DialogText: Because it happened to me. I used to be one of them. I thought
            I was doing the difficult thing, the noble thing.
          m_Duration: 8.30000019
        - m_DialogText: What others couldn't do because they were too weak. It was
            only after the damage was done
          m_Duration: 5.19999981
        - m_DialogText: that I realized what a mistake I had made. And I'm still trying
            to claw my way out of hell.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11233}
        m_AnimationName: Default_CON_SaTi_Tiven_035
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: ace91e7f80da84741bc977a3340232d7, type: 3}
        m_SequenceDialog:
        - m_DialogText: My situation is very different Mr. Saxon. But I can tell you're
            a man of principle, and it seems you want to help.
          m_Duration: 7
        - m_DialogText: Let me return the favor. I'm going to administer a disruptive
            charge to the Argus Implant in your skull. That should weaken the
          m_Duration: 7.5
        - m_DialogText: signal for a while, giving you some breathing room. Some old
            friends of yours are waiting for you in the lower lab.
          m_Duration: 6.80000019
        - m_DialogText: If you use this pass code you'll have an easier time reaching
            them in once piece. Good luck Ben.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21013}
      m_TriggerFunctionName: LearnPassword
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: LOGIC
      m_ChoiceHighlightString: The Tyrants are a tool of the Illuminati. The never
        'help' anyone but their masters...
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Saxon_037
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 8e12015b922dfe84aa4b5db46913e4b9, type: 3}
        m_SequenceDialog:
        - m_DialogText: The Tyrants are a tool of the Illuminati. The never 'help'
            anyone but their masters. They take advantage of over-ambitious fools
          m_Duration: 7.9000001
        - m_DialogText: ' like you then dispose of the evidence once they''ve gotten
            what they want. You have a logical mind Dr. Tiven.'
          m_Duration: 7.80000019
        - m_DialogText: Put the pieces together and you'll see they're using you.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_036
        m_BodyAnimationName: 
        m_AudioVO: {fileID: 8300000, guid: 280ac98f4c0160747830a95e9de2ed1f, type: 3}
        m_SequenceDialog:
        - m_DialogText: I can tell you believe what you're saying, but you simply
            don't understand the situation.
          m_Duration: 5.19999981
        - m_DialogText: You've caused enough trouble for me already, please leave
            me alone.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21013}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: 
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString: 
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString: 
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
