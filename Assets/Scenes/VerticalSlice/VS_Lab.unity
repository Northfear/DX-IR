--- !u!114 &21071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Topics of Question
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: ARGUS IMPLANT
      m_ChoiceHighlightString: The Argus Implant. You created it?
      m_ConnectingConversation: {fileID: 21071}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_013
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_013
        m_SequenceDialog:
        - m_DialogText: The Argus Implant. You created it? What does it do?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_014
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_014
        m_SequenceDialog:
        - m_DialogText: A brilliant piece of work. Top of the line espionage. It monitors your location and transmits it at regular intervals.
          m_Duration: 7.3
        - m_DialogText: Not just that, but sights, sounds, smells. It's like having your own guardian angel, over your shoulder. Always watching.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_015
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_015
        m_SequenceDialog:
        - m_DialogText: How did I get it? I never consented to this. And during my time with Belltower it never appeared on any of my charts.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_016
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_016
        m_SequenceDialog:
        - m_DialogText: Well originally it was only for foreign agents. Prisoners of war and such. So when they were released back to their home
          m_Duration: 7.2
        - m_DialogText: countries and agencies we could keep an eye on them. But Belltower has become more and more... flexible.
          m_Duration: 8.6
        - m_DialogText: And this type of thing has become more common.
          m_Duration: 3.3
        - m_DialogText: Seriously Ben, did you think you could join the Tyrants without someone keeping a close watch.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_017
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_017
        m_SequenceDialog:
        - m_DialogText: Namir! He's been watching me. He knows I'm here.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: TYRANTS
      m_ChoiceHighlightString: You're working for the Tyrants...
      m_ConnectingConversation: {fileID: 21071}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_018
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_018
        m_SequenceDialog:
        - m_DialogText: You're working for the Tyrants. They're a group of murderers, which makes you an accessory to murder.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_019
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_019
        m_SequenceDialog:
        - m_DialogText: 'Please. I''m a scientist. I''m merely pushing the boundaries of what is possible. I''m not responsible '
          m_Duration: 6.2
        - m_DialogText: for what other people do with my creations. The Tyrants are just another a client. A powerful client, but a client nonetheless.
          m_Duration: 8.5
        - m_DialogText: ' And look at the good we''ve been able to achieve. Riezol is going to save millions of lives.'
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: RIEZOL
      m_ChoiceHighlightString: So you're responsible for the new 'miracle drug' Riezol?
      m_ConnectingConversation: {fileID: 21071}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_020
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_020
        m_SequenceDialog:
        - m_DialogText: So you're responsible for the new 'miracle drug' Riezol?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_021
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_021
        m_SequenceDialog:
        - m_DialogText: I can't take all the credit for Riezol. I'm an engineer by training. But Zaphire Biotech employs the most talented chemists in
          m_Duration: 8
        - m_DialogText: the world. And we have benefactors with deep pockets. We're doing what no one has managed to do.
          m_Duration: 7
        - m_DialogText: We're challenging VersaLife, head on. After Riezol hits the market
          m_Duration: 5.2
        - m_DialogText: its going to be adopted by Limb clinics one after another. People won't even remember what Neuropozyne was.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_022
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_022
        m_SequenceDialog:
        - m_DialogText: People say Riezol isn't safe. That it hasn't been tested properly.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_023
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_023
        m_SequenceDialog:
        - m_DialogText: Riezol has been available on the black market for years already. Do you think that's an accident? Its part of our
          m_Duration: 3
        - m_DialogText: accelerated testing' regime. We've been able to iterate on the drug freely, without any oversight. And now we're prepared to
          m_Duration: 3
        - m_DialogText: reap the rewards. It's not our fault if some of the less scrupulous go-betweens involved have been cutting the drug.
          m_Duration: 3
        - m_DialogText: We've factored this into our field testing, and the results are nothing less than stellar.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString: ENOUGH
      m_ChoiceHighlightString: I've heard enough. I think I understand the situation.
      m_ConnectingConversation: {fileID: 21072}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_024
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_024
        m_SequenceDialog:
        - m_DialogText: I've heard enough. I think I understand the situation.
          m_Duration: 4.3
        - m_DialogText: But what I don't understand is why you're helping me. Why are you giving me this information?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_025
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_025
        m_SequenceDialog:
        - m_DialogText: You asked. I answered. I'm not hiding anything. The question is, what are you hiding? Why did you come here?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence: []
  m_ConversationCamera: {fileID: 11237}
--- !u!114 &21072
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: First Conclusion
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: TO KILL
      m_ChoiceHighlightString: I came here to end this. And if that means I have to take you out... so be it.
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_026
        m_BodyAnimationName:
        m_AudioVO: =
        m_SequenceDialog:
        - m_DialogText: I came here to end this. And if that means I have to take you out... so be it.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_027
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_027
        m_SequenceDialog:
        - m_DialogText: 'How barbaric. I overestimated you Mr. Saxon. I hope you''ll reconsider. '
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21115}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: REMOVE IMPLANT
      m_ChoiceHighlightString: I want this bug out of my head! If you're the one who implanted it, then you can remove it!
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_028
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_028
        m_SequenceDialog:
        - m_DialogText: I want this bug out of my head! If you're the one who implanted it, then you can remove it!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_029
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_029
        m_SequenceDialog:
        - m_DialogText: Regrettably, I can't remove it now, Ben. There's not enough time, with the lab under emergency lock-down.
          m_Duration: 5.8
        - m_DialogText: A rushed procedure could render you brain dead. But I can do this... I'll administer a disruptive magnetic charge into your skull.
          m_Duration: 8.2
        - m_DialogText: That will delay the implant's transmission rate and scramble some of the data. Consider this a favor.
          m_Duration: 6.2
        - m_DialogText: It should give you some breathing room to accomplish... whatever it is you're pursuing.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21115}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: GET NAMIR
      m_ChoiceHighlightString: Namir screwed me over once. I'm not going to let him get away with it again. If what you said is true, then Namir must be nearby, on my trail.
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_030
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_030
        m_SequenceDialog:
        - m_DialogText: Namir screwed me over once. I'm not going to let him get away with it again.
          m_Duration: 5.6
        - m_DialogText: If what you said is true, then Namir must be nearby, on my trail. Help me find him and I'll let you live.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_031
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_031
        m_SequenceDialog:
        - m_DialogText: How compassionate of you. You're right though. Namir is here, tonight. I'll give you a pass code which should let you bypass
          m_Duration: 8.1
        - m_DialogText: 'security measures in the lower lab. I hope you find what you''re looking for. '
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21115}
      m_TriggerFunctionName: LearnPassword
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString: 'APPEAL '
      m_ChoiceHighlightString: Listen Isaac. I can respect what you're doing here...
      m_ConnectingConversation: {fileID: 21073}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_032
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_032
        m_SequenceDialog:
        - m_DialogText: Listen Isaac. I can respect what you're doing here. Zaphire Biotech is shaking up the whole anti-rejection market.
          m_Duration: 8
        - m_DialogText: And that's probably a good thing. But Namir, and the Tyrants. They're pure poison.
          m_Duration: 7.1
        - m_DialogText: And your involvement with them is going to corrupt everything you touch.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_033
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_033
        m_SequenceDialog:
        - m_DialogText: That's quite an indictment. How can you be so sure?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence: []
  m_ConversationCamera: {fileID: 11237}
--- !u!114 &21073
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 4232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Appeal Choices
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: HISTORY
      m_ChoiceHighlightString: Because it happened to me. I used to be one of them..
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11237}
        m_AnimationName: Default_CON_SaTi_Saxon_034
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_034
        m_SequenceDialog:
        - m_DialogText: Because it happened to me. I used to be one of them. I thought I was doing the difficult thing, the noble thing.
          m_Duration: 8.3
        - m_DialogText: What others couldn't do because they were too weak. It was only after the damage was done
          m_Duration: 5.2
        - m_DialogText: that I realized what a mistake I had made. And I'm still trying to claw my way out of hell.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11234}
        m_AnimationName: Default_CON_SaTi_Tiven_035
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_035
        m_SequenceDialog:
        - m_DialogText: My situation is very different Mr. Saxon. But I can tell you're a man of principle, and it seems you want to help.
          m_Duration: 7
        - m_DialogText: Let me return the favor. I'm going to administer a disruptive charge to the Argus Implant in your skull. That should weaken the
          m_Duration: 7.5
        - m_DialogText: signal for a while, giving you some breathing room. Some old friends of yours are waiting for you in the lower lab.
          m_Duration: 6.8
        - m_DialogText: If you use this pass code you'll have an easier time reaching them in once piece. Good luck Ben.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21115}
      m_TriggerFunctionName: LearnPassword
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: LOGIC
      m_ChoiceHighlightString: The Tyrants are a tool of the Illuminati. The never 'help' anyone but their masters...
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 11236}
        m_AnimationName: Default_CON_SaTi_Saxon_037
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Saxon_037
        m_SequenceDialog:
        - m_DialogText: The Tyrants are a tool of the Illuminati. The never 'help' anyone but their masters. They take advantage of over-ambitious fools
          m_Duration: 7.9
        - m_DialogText: ' like you then dispose of the evidence once they''ve gotten what they want. You have a logical mind Dr. Tiven.'
          m_Duration: 7.8
        - m_DialogText: Put the pieces together and you'll see they're using you.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 11235}
        m_AnimationName: Default_CON_SaTi_Tiven_036
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaTi_Tiven_036
        m_SequenceDialog:
        - m_DialogText: I can tell you believe what you're saying, but you simply don't understand the situation.
          m_Duration: 5.2
        - m_DialogText: You've caused enough trouble for me already, please leave me alone.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 21115}
      m_TriggerFunctionName: ConversationEnded
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
