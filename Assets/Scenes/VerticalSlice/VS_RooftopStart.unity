--- !u!114 &15811
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 2426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Roof_01_Anna_01
      m_CommSubtitle: Good job Ben. You've landed outside radar cover and the security team hasn't detected you yet.
    - m_EventType: 0
      m_TriggerDelay: 5.5
      m_CommAudioEvent: Play_Comm_Roof_01_Ben_02
      m_CommSubtitle: Roger. I'll find them before they find me.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Roof_02_Anna_01
      m_CommSubtitle: Ben, there's a communications antenna ahead. If you plant the transmission device I'll be able to hack into Zaphire's security grid.
    - m_EventType: 0
      m_TriggerDelay: 7.3
      m_CommAudioEvent: Play_Comm_Roof_02_Ben_02
      m_CommSubtitle: I'll keep an eye out for it.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Roof_03_Ben_01
      m_CommSubtitle: Alright, I've planted the device.
    - m_EventType: 1
      m_TriggerDelay: 2.4
      m_CommAudioEvent: Play_Comm_Roof_03_Anna_02
      m_CommSubtitle: Great, tapping in now... There's a... secured door ahead, and the pass code is... 0119. Do you copy? 0119.
    - m_EventType: 0
      m_TriggerDelay: 12.2
      m_CommAudioEvent: Play_Comm_Roof_03_Ben_03
      m_CommSubtitle: Copy, thanks Anna.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Comm_Roof_04_Anna_01
      m_CommSubtitle: There's some heavy security on this door. I can't help you unless you plant the transmission device.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: "Play_Comm_Roof_05_Anna_01\r"
      m_CommSubtitle: You're entering the helipad control room. Security expected you to land here, so you should be able to catch them with their pants down.
    - m_EventType: 0
      m_TriggerDelay: 7.1
      m_CommAudioEvent: "Play_Comm_Roof_05_Ben_02\r"
      m_CommSubtitle: Just the way I like it.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: "Stop_Comm_Roof_06_Ben_01\r"
      m_CommSubtitle: Anna, Belltower chopper outbound.
    - m_EventType: 1
      m_TriggerDelay: 2
      m_CommAudioEvent: "Play_Comm_Roof_06_Anna_02\r"
      m_CommSubtitle: I'm on it, probably headed after ours. I've already given him the heads up. You might be stuck there a while Ben.
    - m_EventType: 0
      m_TriggerDelay: 8.5
      m_CommAudioEvent: "Play_Comm_Roof_06_Ben_03\r"
      m_CommSubtitle: Fine with me, more time to play.
