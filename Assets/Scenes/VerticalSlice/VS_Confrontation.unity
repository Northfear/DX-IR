--- !u!114 &5679
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Conclusion
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: STRENGTH
      m_ChoiceHighlightString: If you think your new found strength is going to save you you're going to be painfully disappointed!
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_025
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_025
        m_SequenceDialog:
        - m_DialogText: If you think your new found strength is going to save you you're going to be painfully disappointed!
          m_Duration: 4.6
        - m_DialogText: I've been down that path Sam, and the only thing waiting for you is misery and regret.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_026
        m_BodyAnimationName: bedBreathingidle
        m_AudioVO: Play_CON_SaDu_Duarte_026
        m_SequenceDialog:
        - m_DialogText: You're not my CO Ben. That time has passed. You stabbed me in the back but I survived. And when I get the chance,
          m_Duration: 10.1
        - m_DialogText: ' I''m going to pull the knife out... and stab you in the heart.'
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 5740}
      m_TriggerFunctionName: StartOutro
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: FAMILY
      m_ChoiceHighlightString: What's happened to you Sam? You're really twisted. How badly have they scrambled your brain?
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_027
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_027
        m_SequenceDialog:
        - m_DialogText: What's happened to you Sam? You're really twisted. How badly have they scrambled your brain?
          m_Duration: 5.1
        - m_DialogText: Don't you remember anything about your life, and who you are? You have a family waiting for you.
          m_Duration: 4.9
        - m_DialogText: ' I''ve spent time with them back in Costa Rica. They''re good people. And they deserve to get you back.'
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3683}
        m_AnimationName: Default_CON_SaDu_Duarte_028
        m_BodyAnimationName: bedBreathingidle_HeadDown
        m_AudioVO: Play_CON_SaDu_Duarte_028
        m_SequenceDialog:
        - m_DialogText: (pause) I have no memory of my family. (sigh)
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_029
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaDu_Saxon_029
        m_SequenceDialog:
        - m_DialogText: I can help you Sam. I've got to get you out of here.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_030
        m_BodyAnimationName: bedBreathingidle_HeadRight
        m_AudioVO: Play_CON_SaDu_Duarte_030
        m_SequenceDialog:
        - m_DialogText: It's too late. It's too late.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 5740}
      m_TriggerFunctionName: StartOutro
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: NAMIR
      m_ChoiceHighlightString: 'It''s Namir. He''s done this to you. '
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_031
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_031
        m_SequenceDialog:
        - m_DialogText: It's Namir. He's done this to you. He breaks people down, severs their ties to anything that makes them human,
          m_Duration: 6.3
        - m_DialogText: then rebuilds them into robots. Killing machines. The tools he uses to carry out his plans.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3684}
        m_AnimationName: Default_CON_SaDu_Duarte_032
        m_BodyAnimationName: bedBreathingidle
        m_AudioVO: Play_CON_SaDu_Duarte_032
        m_SequenceDialog:
        - m_DialogText: He saved my life.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_033
        m_BodyAnimationName: Point_Unsure
        m_AudioVO: Play_CON_SaDu_Saxon_033
        m_SequenceDialog:
        - m_DialogText: No. He's done just the opposite. He's destroyed any chance of you rejoining the human race. He's made you into a monster.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_034
        m_BodyAnimationName: bedBreathingidle_HeadDown
        m_AudioVO: Play_CON_SaDu_Duarte_034
        m_SequenceDialog:
        - m_DialogText: I guess that's just where you and I part ways old buddy.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 5740}
      m_TriggerFunctionName: StartOutro
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO:
        m_SequenceDialog:
        - m_DialogText: Listen Isaac. I can respect what you're doing here. Zaphire Biotech is shaking up the whole anti-rejection market.
          m_Duration: 8
        - m_DialogText: And that's probably a good thing. But Namir, and the Tyrants. They're pure poison.
          m_Duration: 7.1
        - m_DialogText: And your involvement with them is going to corrupt everything you touch.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 0}
        m_AnimationName: Default_CON_SaTi_Tiven_033
        m_BodyAnimationName:
        m_AudioVO: "\u0010\u0002"
        m_SequenceDialog:
        - m_DialogText: That's quite an indictment. How can you be so sure?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence: []
  m_ConversationCamera: {fileID: 0}
--- !u!114 &5680
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Aftermath Info
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: SURVIVE
      m_ChoiceHighlightString: Sam, I'm not going to argue with you in your current state. But you're way off.
      m_ConnectingConversation: {fileID: 5679}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_019
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_019
        m_SequenceDialog:
        - m_DialogText: Sam, I'm not going to argue with you in your current state. But you're way off.
          m_Duration: 3.1
        - m_DialogText: I tried to save you, but I saw you get cut down by a drone. And I barely survived myself. How did you make it out of there?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3684}
        m_AnimationName: Default_CON_SaDu_Duarte_020
        m_BodyAnimationName: bedBreathingidle
        m_AudioVO: Play_CON_SaDu_Duarte_020
        m_SequenceDialog:
        - m_DialogText: After you abandoned me I bled out. It seemed like days. I woke up in the hospital
          m_Duration: 7.2
        - m_DialogText: and I could see myself lying on an operating table. I thought maybe I had escaped my own body, like a spirit y'know?
          m_Duration: 9.7
        - m_DialogText: What I saw, what it really was, was my new optics tapping in. The signal was live before they were implanted.
          m_Duration: 10
        - m_DialogText: But piece by piece they put me back together. And now I'm back. I'm back Ben. Born again hard. All my weaknesses...
          m_Duration: 11.2
        - m_DialogText: replaced by strengths.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: INFORMATION
      m_ChoiceHighlightString: I don't know where you're getting your information but you're way off.
      m_ConnectingConversation: {fileID: 5679}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_021
        m_BodyAnimationName: Point_Unsure
        m_AudioVO: Play_CON_SaDu_Saxon_021
        m_SequenceDialog:
        - m_DialogText: I don't know where you're getting your information but you're way off.
          m_Duration: 3.1
        - m_DialogText: I had nothing to do with Operation Rainbird being sabotaged. And I almost died trying to get you out of there.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3684}
        m_AnimationName: Default_CON_SaDu_Duarte_022
        m_BodyAnimationName: bedBreathingidle
        m_AudioVO: Play_CON_SaDu_Duarte_022
        m_SequenceDialog:
        - m_DialogText: He said you'd try that. You'd try to get all buddy-buddy with me. Old war pals right?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_023
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_023
        m_SequenceDialog:
        - m_DialogText: Who are you talking about Sam? Who's got a hold of you?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_024
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaDu_Duarte_024
        m_SequenceDialog:
        - m_DialogText: I'm part of a new team now. A team with a strong leader. Someone who would die for his men. Not a coward like you.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: "u\u0001"
        m_SequenceDialog:
        - m_DialogText: I've heard enough. I think I understand the situation.
          m_Duration: 4.3
        - m_DialogText: But what I don't understand is why you're helping me. Why are you giving me this information?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 0}
        m_AnimationName: Default_CON_SaTi_Tiven_025
        m_BodyAnimationName:
        m_AudioVO:
        m_SequenceDialog:
        - m_DialogText: You asked. I answered. I'm not hiding anything. The question is, what are you hiding? Why did you come here?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
