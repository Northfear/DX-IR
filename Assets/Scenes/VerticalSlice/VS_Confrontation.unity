--- !u!114 &5682
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: SABOTAGED
      m_ChoiceHighlightString: No Sam. We were sabotaged. Operation Rainbird was a setup.
      m_ConnectingConversation: {fileID: 5681}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_009
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_009
        m_SequenceDialog:
        - m_DialogText: No Sam. We were sabotaged. Operation Rainbird was a setup.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3684}
        m_AnimationName: Default_CON_SaDu_Duarte_010
        m_BodyAnimationName:
        m_AudioVO: Play_CON_SaDu_Duarte_010
        m_SequenceDialog:
        - m_DialogText: You're sure it was a setup? Of course you are. You're the one who planned it.
          m_Duration: 4.7
        - m_DialogText: You planned the deaths of everyone on your team, including me.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: ROGUE
      m_ChoiceHighlightString: Turned rogue? I guess you could call it that. But I had reasons for what I did.
      m_ConnectingConversation: {fileID: 5681}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_011
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_011
        m_SequenceDialog:
        - m_DialogText: Turned rogue? I guess you could call it that. But I had reasons for what I did.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_012
        m_BodyAnimationName: bedBreathingidle_HeadRight
        m_AudioVO: Play_CON_SaDu_Duarte_012
        m_SequenceDialog:
        - m_DialogText: I know the truth. Your 'reasons' were pure selfish motivation.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString: DISHONOR
      m_ChoiceHighlightString: I never dishonored the unit! I did everything I could to save the team. I did everything I could to save you.
      m_ConnectingConversation: {fileID: 5681}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_013
        m_BodyAnimationName: Point_Unsure
        m_AudioVO: Play_CON_SaDu_Saxon_013
        m_SequenceDialog:
        - m_DialogText: I never dishonored the unit! I did everything I could to save the team. I did everything I could to save you.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_014
        m_BodyAnimationName: bedBreathingidle_HeadRight
        m_AudioVO: Play_CON_SaDu_Duarte_014
        m_SequenceDialog:
        - m_DialogText: No one expects a coward to take responsibility for his actions. You make me sick.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 3687}
    m_AnimationName: Default_CON_SaDu_Saxon_001
    m_BodyAnimationName: Standing_Action
    m_AudioVO: PLAY_CON_SADU_SAXON_001
    m_SequenceDialog:
    - m_DialogText: Sam! Samuel Duarte! You were killed six months ago.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 3685}
    m_AnimationName: Default_CON_SaDu_Duarte_002
    m_BodyAnimationName:
    m_AudioVO: PLAY_CON_SADU_DUARTE_002
    m_SequenceDialog:
    - m_DialogText: 'Rend your hearts, not your garments, and return to the Lord, your God. '
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 3687}
    m_AnimationName: Default_CON_SaDu_Saxon_003
    m_BodyAnimationName:
    m_AudioVO: Play_CON_SaDu_Saxon_003
    m_SequenceDialog:
    - m_DialogText: Sam... can you hear me?
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 3683}
    m_AnimationName: Default_CON_SaDu_Duarte_004
    m_BodyAnimationName:
    m_AudioVO: Play_CON_SaDu_Duarte_004
    m_SequenceDialog:
    - m_DialogText: For gracious and merciful, is He, slow to anger, rich in kindness, and relenting in punishment.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 3687}
    m_AnimationName: Default_CON_SaDu_Saxon_005
    m_BodyAnimationName:
    m_AudioVO: Play_CON_SaDu_Saxon_005
    m_SequenceDialog:
    - m_DialogText: It's me, Ben Saxon. Tell me Sam, can you hear me?
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 3683}
    m_AnimationName: Default_CON_SaDu_Duarte_006
    m_BodyAnimationName:
    m_AudioVO: Play_CON_SaDu_Duarte_006
    m_SequenceDialog:
    - m_DialogText: 'Benjamin Anthony Saxon. Former SAS squad leader. Decorated for bravery under fire. '
      m_Duration: 8.2
    - m_DialogText: Former Belltower private security agent. Commended for excellence in command.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 3687}
    m_AnimationName: Default_CON_SaDu_Saxon_007
    m_BodyAnimationName:
    m_AudioVO: Play_CON_SaDu_Saxon_007
    m_SequenceDialog:
    - m_DialogText: Sam...
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 3684}
    m_AnimationName: Default_CON_SaDu_Duarte_008
    m_BodyAnimationName: bedBreathingidle
    m_AudioVO: Play_CON_SaDu_Duarte_008
    m_SequenceDialog:
    - m_DialogText: Team leader of special operations unit Strike Six. Responsible for the failure of Operation Rainbird and the death of his men.
      m_Duration: 9.6
    - m_DialogText: Dishonorably discharged. Disgraced. Turned rogue.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 0}
