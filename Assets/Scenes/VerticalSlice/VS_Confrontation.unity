--- !u!114 &5681
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Catching Up
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: CONTEMPT
      m_ChoiceHighlightString: Maybe my memory has failed me. Why don't you catch me up then, tell me what you think happened!
      m_ConnectingConversation: {fileID: 5680}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_015
        m_BodyAnimationName: Point_Unsure
        m_AudioVO: Play_CON_SaDu_Saxon_015
        m_SequenceDialog:
        - m_DialogText: Maybe my memory has failed me. Why don't you catch me up then, tell me what you think happened!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3684}
        m_AnimationName: Default_CON_SaDu_Duarte_016
        m_BodyAnimationName: bedBreathingidle
        m_AudioVO: Play_CON_SaDu_Duarte_016
        m_SequenceDialog:
        - m_DialogText: You leaked classified information which resulted in the extermination of your team.
          m_Duration: 5.8
        - m_DialogText: Tell me Ben, how much did it cost the SAF to pay you off? How much... per squad member was it?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: RECONCILE
      m_ChoiceHighlightString: Sam you've been through so much. I'm just glad to see you're alive. I think your memory's been shaken, friend.
      m_ConnectingConversation: {fileID: 5680}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3687}
        m_AnimationName: Default_CON_SaDu_Saxon_017
        m_BodyAnimationName: Standing_Action
        m_AudioVO: Play_CON_SaDu_Saxon_017
        m_SequenceDialog:
        - m_DialogText: Sam you've been through so much. I'm just glad to see you're alive. I think your memory's been shaken, friend.
          m_Duration: 6
        - m_DialogText: Lets walk through it. What's the last thing you remember before the crash?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3685}
        m_AnimationName: Default_CON_SaDu_Duarte_018
        m_BodyAnimationName: bedBreathingidle_HeadRight
        m_AudioVO: Play_CON_SaDu_Duarte_018
        m_SequenceDialog:
        - m_DialogText: Alright, friend. Right after the drones you ordered shot us down you left me for dead. How's that for clarity?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
