--- !u!114 &16237
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 3580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: BREAK IN
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8960}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Tell me where your VTOL is parked and I'll break in and disable the security.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 8959}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: That's a risky operation! The Belltower base is hidden beneath the XNG Data Center downtown.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8960}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I'll contact you when its clear and you can get your ship out of there.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 16134}
      m_TriggerFunctionName: AcceptBelltowerMission
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: STEAL IT
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8960}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: What's it going to take to get your ship out of there?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 8959}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_10sec
        m_SequenceDialog:
        - m_DialogText: I'll give you my passcode which will provide you access to the Belltower facility hidden under the XNG Data Center downtown.
          m_Duration: 5
        - m_DialogText: If you loop the helipad security footage, I can recover the VTOL without being spotted.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8960}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO:
        m_SequenceDialog:
        - m_DialogText: I'll do it. But don't leave me behind!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 16134}
      m_TriggerFunctionName: AcceptBelltowerMission
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 8960}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: The VIP is dead, but I made a copy of his investigation report on Riezol.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 8959}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: I don't like this at all. We've got to get out of here, but my VTOL is under surveillance.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 0}
