--- !u!114 &16144
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1837}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: WHERE AT?
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8961}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Where did you drop him off? I'd like to have a word with him.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 8958}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: The high-rise downtown. Be careful, security there is tight.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 16134}
      m_TriggerFunctionName: KasparInvestigate
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: WHAT HAPPENED?
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 8961}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: So you think something happened to him. What makes you so sure?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 8958}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Some spooks showed up at BT HQ a day before the VIP arrived. And the VTOL I fly got bugged the day before I picked him up.
          m_Duration: 5
        - m_DialogText: I ditched the tracker after I dropped the VIP off at the high-rise downtown. Bad news man.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 16134}
      m_TriggerFunctionName: KasparInvestigate
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice5:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 8958}
    m_AnimationName:
    m_BodyAnimationName: Play_Silence_5sec
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Who the hell are you?
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 8961}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Ben Saxon, former BT SS. I want to know why Belltower is leaking Riezol on the streets of Panama City.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 8958}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: That's a dangerous question to ask. The last VIP I carried asked something similar and I haven't heard from him since I dropped him off.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 0}
