--- !u!114 &8796
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1796}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName:
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: CAMILA
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4755}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_10sec
        m_SequenceDialog:
        - m_DialogText: Ms Rocha is defending her position. Just like your men are defending your turf.
          m_Duration: 4
        - m_DialogText: But you've overstepped your bounds... Jefe. And you're pushing drugs downtown. That's why I'm here.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4756}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_10sec
        m_SequenceDialog:
        - m_DialogText: 'No me jodas! The streets belong to me. LIMB''s market is legit, and their customers are rich. '
          m_Duration: 5
        - m_DialogText: 'But I give people what they really want. '
          m_Duration: 2
        - m_DialogText: We're two sides of the same coin. And you can't have one without the other.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 8803}
      m_TriggerFunctionName: SpawnNeutralGangsters
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 40
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
