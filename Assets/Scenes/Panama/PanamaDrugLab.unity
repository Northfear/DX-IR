    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 4756}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_10sec
    m_SequenceDialog:
    - m_DialogText: Who sent you here anyway? The bitch down at the LIMB clinic or that kueko Cobra and his pequeño rifles.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 4756}
