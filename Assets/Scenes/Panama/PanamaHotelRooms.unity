--- !u!114 &17560
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Welcome to Panama City Ben. Good luck finding that doctor.
    - m_EventType: 0
      m_TriggerDelay: 3.5
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Thanks for the encouragement.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Anna, it looks like securing Neuropozyne is going to be more difficult than I thought.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I'm sorry Ben. You should have taken the last dose, not me.
  - m_CharacterPortrait: {fileID: 2800000, guid: c363bf5926329aa4d9bffe84d13a45cb, type: 3}
    m_CharacterName: Kaspar Havekes
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Kaspar, you were right. Someone got to the VIP already.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Meet me back at Nightshades. We'll figure out what to do.
  - m_CharacterPortrait: {fileID: 2800000, guid: c363bf5926329aa4d9bffe84d13a45cb, type: 3}
    m_CharacterName: Kaspar Havekes
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I looped the security video. It's all clear.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Alright, get out of there and I'll fly off in the VTOL. I'll meet you on the roof of the high-rise downtown.
    - m_EventType: 0
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: One more thing. Those spooks you mentioned. I know who they are...
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Anna, the Limb doctor discovered an implant in my head developed by Zaphire Biotech.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Zaphire Biotech? That's the same company that manufactures Riezol. Sounds fishy!
  - m_CharacterPortrait: {fileID: 2800000, guid: c363bf5926329aa4d9bffe84d13a45cb, type: 3}
    m_CharacterName: Kaspar Havekes
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Did you think I was going to leave without you?
    - m_EventType: 0
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Lets got to Australia and pay Mr. Tiven a visit.
