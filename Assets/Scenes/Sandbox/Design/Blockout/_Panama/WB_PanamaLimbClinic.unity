  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 5202}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Can you help me? I've run out of Neurpozyne.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 5201}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_10sec
    m_SequenceDialog:
    - m_DialogText: Your augs... they're military grade. Those are illegal here in Panama City.
      m_Duration: 5
    - m_DialogText: I'm afraid Limb cannot provide you any treatment.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 0}
