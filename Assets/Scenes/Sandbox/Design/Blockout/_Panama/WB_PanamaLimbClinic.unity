MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 70}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: IMPLANT
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 5207}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Alvaro noticed something wrong with my neural implants. He said you might be able to help me.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 5204}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_10sec
        m_SequenceDialog:
        - m_DialogText: That's asking a lot. I could lose my job. I need you to help me first.
          m_Duration: 3
        - m_DialogText: The drug dealers on the outskirts of town are starting to push Riezol downtown.
          m_Duration: 3
        - m_DialogText: I want you to meet with a contact named Cobra in the trainstation. He'll show you how to shut them down.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 8906}
      m_TriggerFunctionName: AcceptRizeolMission
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: SCANNER
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 5207}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Is it possible for me to use one of your scanners? I'm concerned about my neural augmentations.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 5204}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_10sec
        m_SequenceDialog:
        - m_DialogText: Your augmentations are military grade, so technically we cannot service you here.
          m_Duration: 3
        - m_DialogText: But I would be willing to take the risk if you help me out.
          m_Duration: 3
        - m_DialogText: Meet a contact who goes by the name Cobra down at the train station. He will give you more details.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 8906}
      m_TriggerFunctionName: AcceptRizeolMission
      m_FailedConnectingConversation: {fileID: 0}
