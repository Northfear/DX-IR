    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Camila Rocha? Alvaro said you might be able to help me.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 5204}
    m_AnimationName:
    m_BodyAnimationName:
