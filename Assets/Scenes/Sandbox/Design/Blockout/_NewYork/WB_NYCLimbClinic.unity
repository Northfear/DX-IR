MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1037}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: How's he doing doc? Ben, are you okay?
    - m_EventType: 0
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Uggg.....
  - m_CharacterPortrait: {fileID: 2800000, guid: ab063919952e6694792fde7b94f148da, type: 3}
    m_CharacterName: Isaac Tiven
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: He'll be alright Ms Kelso. It may take a while for the drugs to wear off. But I guess bedrest is out of the question, given your situation.
    - m_EventType: 0
      m_TriggerDelay: 5
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I'll be fine.
    - m_EventType: 0
      m_TriggerDelay: 8
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: But I need to know what the Tyrants are planning.
    - m_EventType: 0
      m_TriggerDelay: 11
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Before it's too late.
    - m_EventType: 1
      m_TriggerDelay: 14
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Ben, if you want to find the truth, then follow the money.
    - m_EventType: 1
      m_TriggerDelay: 20
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Zaphire's finances were being manipulated and I'm certain the Tyrants were involved.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I know someone who can help. The hackers on the Old Carrier. They can crack any bank account.
    - m_EventType: 0
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Alright, get me back on my feet.
