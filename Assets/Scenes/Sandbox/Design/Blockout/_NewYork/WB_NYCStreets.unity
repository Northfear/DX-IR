--- !u!114 &8532
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1815}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name:
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: c363bf5926329aa4d9bffe84d13a45cb, type: 3}
    m_CharacterName: Kaspar Havekes
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: This is the end of the line. Welcome to NYC.
    - m_EventType: 0
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Thanks Kaspar.
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0, type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_10sec
      m_CommSubtitle: Ben, this frequency is being monitored so I can't say much. I've secured a room under a false name. An old friend of mine...
    - m_EventType: 0
      m_TriggerDelay: 5
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I'll find you Anna.
  - m_CharacterPortrait: {fileID: 2800000, guid: 9e8c6c6652f27984dacfa3a4a006fa02, type: 3}
    m_CharacterName: Widow
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I planted the uplink.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: You better get out of there before I crack this open.
    - m_EventType: 0
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Wait until I get back!
  - m_CharacterPortrait: {fileID: 2800000, guid: 3da00434162757943a5242711944ef45, type: 3}
    m_CharacterName: Janus
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: A cyber-attack on the bank is a risky move. You're likely to be caught.
    - m_EventType: 0
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: I'm willing to chance it.
    - m_EventType: 1
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Widow does not poses the skills necessary to pull this off.
    - m_EventType: 0
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Then what do you suggest?
    - m_EventType: 1
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Once she's patched in, keep her from severing the connection. I'll use her breachpoint to investigate the network. Don't let her disconnect.
  - m_CharacterPortrait: {fileID: 2800000, guid: 3a44c8d4e5efd0743875fb2dc7267c0e, type: 3}
    m_CharacterName: Sam Duarte
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: If you want to get Anna back, you'll know where to find me. Watch the news...
