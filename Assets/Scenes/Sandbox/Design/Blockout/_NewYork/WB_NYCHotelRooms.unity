  m_PersuasionInfo:
    m_ProfileTitleText:
    m_ProfileText:
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 2206}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Glad to see you made it in one piece.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 2207}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: It's good to see you too Anna.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 2206}
    m_AnimationName:
    m_BodyAnimationName:
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: I used my East Coast contacts to arrange for a doctor to remove the Argus Implant from your head.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 2207}
