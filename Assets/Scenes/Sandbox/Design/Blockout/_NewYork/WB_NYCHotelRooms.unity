--- !u!114 &4094
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 452}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name:
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: WHAT DOCTOR
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 2207}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Who's the doctor? How do you know he can handle this type of operation. It's MY brain!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 2206}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: You're just going to have to trust me on this one Ben.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 4074}
      m_TriggerFunctionName: MetAnna
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: WHERE AT
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 2207}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Where do I meet him?
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 2206}
        m_AnimationName:
        m_BodyAnimationName:
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: He's prepping an operating room at the local Limb. You should hurry.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 4074}
      m_TriggerFunctionName: MetAnna
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice3:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName:
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice4:
      m_ChoiceString:
      m_ChoiceHighlightString:
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences: []
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName:
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
