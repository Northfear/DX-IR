  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: ZAPHIRE
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 7709}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Look up the financial records for Zaphire Biotech. All revenues
            and expenditures.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4002}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Hold on. I think I'm being traced. My proxies are failing
            one after another.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4006}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: You need a human proxy. Someone on the same regional network.
            Someone in the city.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
