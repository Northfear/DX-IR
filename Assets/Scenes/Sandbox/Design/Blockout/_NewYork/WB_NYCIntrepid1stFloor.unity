--- !u!114 &7710
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: Trust
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: TRUST ME
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 7711}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: It's okay Widow, you can trust her as well as you can trust
            me.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4000}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Skinny bitch...
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4006}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: There is a complete record of Zaphire's financial history
            stored in backup archives. I'm compromising the password security now.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4002}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Got it! Downloading the records now. Hmmm this is interesting.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4002}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Zaphire received investment funds almost exlusively through
            subsidiaries of VersaLife!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: That's impossible! Zaphire is VersaLife's biggest competitor.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4006}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Zaphire is a puppet corporation, controlled by VersaLife and
            the Illuminati. The development of Riezol is just a tool to manipulate
            the market.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 0}
      m_TriggerFunctionName: 
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
