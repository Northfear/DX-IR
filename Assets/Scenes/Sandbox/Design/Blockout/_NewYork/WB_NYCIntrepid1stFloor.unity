    m_SequenceCamera: {fileID: 4002}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Your friend Janus contacted me. I don't like surprises!
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 4006}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: I'm familiar with the network protocol. Trust me, you want my
        help.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 3999}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Alright Widow. If you're ready, lets get started.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 4002}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: I'm scanning for the uplink's GPL signature. Patching into encrypted
        data stream... okay, I have access.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
