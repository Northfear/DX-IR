      m_ChoiceString: ANNA
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 7710}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I'll contact Anna. She can route us through the hotel network.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4000}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Ben, I've got your signal. I'll echoe all commands from the
            hotel network and mask your location.
          m_Duration: 99
