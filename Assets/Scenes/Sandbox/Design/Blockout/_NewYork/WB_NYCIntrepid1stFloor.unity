--- !u!114 &7701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 383}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: Introduction
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: UPLINK
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4003}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I can get inside and plant an uplink. Once you retrieve the
            data I'm looking for, the backdoor is open for you to do whatever you
            want.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4005}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Alright killer. You got a deal.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 7737}
      m_TriggerFunctionName: MeetWidow
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
      m_FailedTriggerFunctionName: 
      m_PersuasionAmount: 0
      m_RequiredPersuasionLevel: 0
    m_DialogChoice2:
      m_ChoiceString: FORGET IT
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4003}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I'm wasting my time. I knew this job was out of your league.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4005}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Wait! I'll do it. But you're going to have to physically break
            into the bank's server room and plant this uplink device.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 7737}
      m_TriggerFunctionName: MeetWidow
      m_FailedConnectingConversation: {fileID: 0}
      m_FailedDialogSequences: []
      m_FailedConversationTriggerClass: {fileID: 0}
