--- !u!114 &7711
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c426852d62c3488f9f40b32810f4452, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_ConversationName: More Info
  m_ConversationInfo:
    m_DialogChoice1:
      m_ChoiceString: MORE INFO
      m_ChoiceHighlightString: 
      m_ConnectingConversation: {fileID: 0}
      m_DialogSequences:
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Can you find any more info? I need proof of the conspiracy.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4002}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I'm storing everything on a data spike. It's EMP proof. It
            should be all the evidence you need.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 1
        m_SequenceCamera: {fileID: 4002}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Wait a second. The data stream is tainted. Someone is tracing
            us through our own firewall!
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 3999}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: Anna, filter your connection! Strip out all GPL and ID encrypted
            data.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      - m_DialogTarget: 0
        m_SequenceCamera: {fileID: 4000}
        m_AnimationName: 
        m_BodyAnimationName: 
        m_AudioVO: Play_Silence_5sec
        m_SequenceDialog:
        - m_DialogText: I'm... I'm not sure how. Here, tap into my optics so you can
            see through my eyes. You'll be able to see my screen and tell me what
            to do.
          m_Duration: 99
        m_SequenceDialogIndex: 0
        m_SequenceDialogTimer: 0
      m_ConversationTriggerClass: {fileID: 7737}
