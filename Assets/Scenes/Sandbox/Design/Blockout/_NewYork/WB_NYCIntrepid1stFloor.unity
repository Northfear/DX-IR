--- !u!114 &7722
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1155}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea1f77f7c720c9efcb2a62cac09f75b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_CommDialogs:
  - m_CharacterPortrait: {fileID: 2800000, guid: 0db2133fea2ae1e45a8f8d27fbd758f0,
      type: 3}
    m_CharacterName: Anna Kelso
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Ben, can you see what I'm seeing?
    - m_EventType: 0
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Yeah. Right there with you.
    - m_EventType: 1
      m_TriggerDelay: 6
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Wait a sec. I hear something...
  - m_CharacterPortrait: {fileID: 2800000, guid: 3a44c8d4e5efd0743875fb2dc7267c0e,
      type: 3}
    m_CharacterName: Sam Duarte
    m_DialogEvents:
    - m_EventType: 1
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: You might want to close your eyes. This is going to sting a
        bit.
    - m_EventType: 0
      m_TriggerDelay: 4
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: No Sam.... Anna!
  - m_CharacterPortrait: {fileID: 2800000, guid: 3da00434162757943a5242711944ef45,
      type: 3}
    m_CharacterName: Janus
    m_DialogEvents:
    - m_EventType: 0
      m_TriggerDelay: 0
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: Those bastards took Anna.
    - m_EventType: 1
      m_TriggerDelay: 3
      m_CommAudioEvent: Play_Silence_5sec
      m_CommSubtitle: That's not all Ben. You've got multiple Belltower air units
        moving in. Get out of there!
