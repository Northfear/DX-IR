  m_PersuasionInfo:
    m_ProfileTitleText: 
    m_ProfileText: 
  m_PreChoiceDialogSequence:
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 4003}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: So you're Widow? I heard you're the person to go to when you need
        information other people aren't wlling to give up.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 4005}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Beat it lowlife. I don't do other people's laundry. Come back
        when you have a serious job for me.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 0
    m_SequenceCamera: {fileID: 4003}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Did I mention the target is a bank? A big one.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  - m_DialogTarget: 1
    m_SequenceCamera: {fileID: 4005}
    m_AnimationName: 
    m_BodyAnimationName: 
    m_AudioVO: Play_Silence_5sec
    m_SequenceDialog:
    - m_DialogText: Are you kidding? All the big companies employ hardware firewalls.
        You need help from the inside to pull that off.
      m_Duration: 99
    m_SequenceDialogIndex: 0
    m_SequenceDialogTimer: 0
  m_ConversationCamera: {fileID: 4003}
